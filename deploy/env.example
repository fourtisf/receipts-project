# ───────── App ─────────
APP_NAME=Receipts
APP_DOMAIN=receipts.example            # final domain not decided yet
NODE_ENV=production
WEB_PORT=3000
API_PORT=4000
NEXT_PUBLIC_APP_NAME=Receipts
NEXT_PUBLIC_API_URL=https://receipts.example/api
NEXT_PUBLIC_WS_URL=wss://receipts.example/api/ws
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ───────── Database / cache ─────────
DATABASE_URL=postgresql://receipts:CHANGE_ME@127.0.0.1:5432/receipts?schema=public
REDIS_URL=redis://127.0.0.1:6379

# ───────── Auth ─────────
SESSION_SECRET=                         # 64 random hex chars
SIWE_CHAIN_ID=4663

# ───────── Chain ─────────
CHAIN_ID=4663
RPC_URL=https://robinhood.drpc.org      # use a paid RPC key in production
RPC_URL_FALLBACK=
NEXT_PUBLIC_RPC_URL=https://robinhood.drpc.org
EXPLORER_URL=https://robinhoodchain.blockscout.com
CONFIRMATIONS=3
START_BLOCK=                            # block of SignalRegistry deployment

# Deployed contracts (filled after M1/M6 deploy)
REGISTRY_ADDRESS=
FACTORY_ADDRESS=
NEXT_PUBLIC_REGISTRY_ADDRESS=
NEXT_PUBLIC_FACTORY_ADDRESS=
TREASURY_ADDRESS=

# ───────── Worker keys (server only, never in NEXT_PUBLIC_*) ─────────
EXECUTOR_PRIVATE_KEY=
SIGNER_PRIVATE_KEYS=                    # comma-separated
SALT_ENCRYPTION_KEY=                    # 32-byte hex, AES-256-GCM
MIN_GAS_BALANCE_ETH=0.002

# ───────── Data sources ─────────
MARKET_DATA_PROVIDER=polygon            # polygon | alpaca
MARKET_DATA_API_KEY=
CRYPTO_CANDLES_PROVIDER=coinbase        # coinbase | binance

# ───────── AI strategies ─────────
AI_BASE_URL=                            # OpenAI-compatible endpoint
AI_API_KEY=
AI_MODEL=

# ───────── Ops ─────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SENTRY_DSN=
GEOBLOCK_STOCKS=US

# ───────── Deploy only (local machine, never on the server) ─────────
# DEPLOYER_PRIVATE_KEY=
# BLOCKSCOUT_API_URL=https://robinhoodchain.blockscout.com/api
