# Copy to the repo root as .env (chmod 600). Every app (web, api, worker) loads this one file.
# Values marked REQUIRED must be filled before `pm2 start`. Never commit the filled file.

# ───────── App ─────────
APP_NAME=Receipts
APP_DOMAIN=receipts.example            # REQUIRED final domain (no scheme); SIWE domain + CORS + metadata URIs
NODE_ENV=production
WEB_PORT=3000
API_PORT=4000
API_HOST=127.0.0.1
TRUST_PROXY=loopback                   # client IP from the local Nginx hop only (not spoofable)
API_INTERNAL_URL=http://127.0.0.1:4000 # server-side fetches from Next.js
NEXT_PUBLIC_APP_NAME=Receipts
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_WS_URL=wss://receipts.example/api/ws
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=  # optional (WalletConnect / mobile wallets); injected wallets work without it

# ───────── Database / cache ─────────
DATABASE_URL=postgresql://receipts:CHANGE_ME@127.0.0.1:5432/receipts?schema=public   # REQUIRED
REDIS_URL=redis://127.0.0.1:6379

# ───────── Auth ─────────
SESSION_SECRET=                         # REQUIRED 64 random hex chars: openssl rand -hex 32
SIWE_CHAIN_ID=4663

# ───────── Chain ─────────
CHAIN_ID=4663
RPC_URL=https://robinhood.drpc.org      # REQUIRED in prod: a paid RPC with archive state (dRPC/Alchemy key)
RPC_URL_FALLBACK=
PUBLIC_RPC_URL=https://robinhood.drpc.org       # RPC served to browsers (no secret key in it)
NEXT_PUBLIC_RPC_URL=https://robinhood.drpc.org
EXPLORER_URL=https://robinhoodchain.blockscout.com
CONFIRMATIONS=3
START_BLOCK=                            # REQUIRED after deploy: startBlock from packages/contracts/deployments/4663.json

# Deployed contracts (from packages/contracts/deployments/4663.json after the mainnet deploy)
REGISTRY_ADDRESS=                       # REQUIRED after deploy
FACTORY_ADDRESS=                        # REQUIRED after deploy
NEXT_PUBLIC_REGISTRY_ADDRESS=
NEXT_PUBLIC_FACTORY_ADDRESS=
TREASURY_ADDRESS=                       # receives the protocol cut (multisig recommended)

# House strategies / vaults (public addresses only)
HOUSE_CREATORS=                         # comma-separated creator wallets allowed to carry the HOUSE label
HOUSE_VAULTS=                           # comma-separated house vault addresses shown on the landing page
SIGNER_ADDRESS_TEMPLATE=                # REQUIRED for "Create strategy": address of the platform signer that runs templates (one of SIGNER_PRIVATE_KEYS)
TEMPLATE_REVEAL_WINDOW_SEC=3600

# ───────── Worker keys (server only, never in NEXT_PUBLIC_*) ─────────
EXECUTOR_PRIVATE_KEY=                   # REQUIRED vault operator; holds only gas ETH. Its address = factory default operator
SIGNER_PRIVATE_KEYS=                    # REQUIRED comma-separated signers (house + template signer); gas ETH only
SALT_ENCRYPTION_KEY=                    # REQUIRED 32-byte hex (openssl rand -hex 32); losing it = commits cannot be revealed after a restart
MIN_GAS_BALANCE_ETH=0.002

# ───────── Data sources ─────────
MARKET_DATA_PROVIDER=polygon            # polygon | alpaca
MARKET_DATA_API_KEY=                    # stock candles + headlines (Polygon key, or Alpaca "KEYID:SECRET"); without it stocks fall back to Chainlink rounds
CRYPTO_CANDLES_PROVIDER=coinbase        # coinbase | binance (public, no key)

# ───────── AI strategies ─────────
AI_BASE_URL=                            # OpenAI-compatible endpoint, e.g. https://api.together.xyz/v1
AI_API_KEY=
AI_MODEL=                               # its keccak256 is committed as modelHash; changing it requires a new strategy

# ───────── Ops ─────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SENTRY_DSN=
GEOBLOCK_STOCKS=US

# ───────── Deploy only (local machine, never on the server) ─────────
# DEPLOYER_PRIVATE_KEY=                 # pays for the contract deploy
# EXECUTOR_ADDRESS=                     # Deploy.s.sol: default operator for new vaults (address of EXECUTOR_PRIVATE_KEY)
# PROTOCOL_CUT_BPS=1000                 # Deploy.s.sol: protocol share of creator fees (max 3000)
# MAX_DAILY_LIMIT_USD=2000              # Deploy.s.sol: beta cap per vault per day (whole USD)
# FACTORY_ADMIN=                        # Deploy.s.sol: optional multisig to receive factory admin (two-step)
# HOUSE_CREATOR_PRIVATE_KEY=            # scripts/register-house.ts --broadcast
# BLOCKSCOUT_API_URL=https://robinhoodchain.blockscout.com/api/
