{
  "name": "@receipts/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./abi": {
      "types": "./dist/abi/index.d.ts",
      "default": "./dist/abi/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "gen:config": "node scripts/gen-config.mjs",
    "abi:gen": "node scripts/gen-abi.mjs",
    "build": "node scripts/gen-config.mjs && tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "viem": "^2.38.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "^3.2.4"
  }
}
