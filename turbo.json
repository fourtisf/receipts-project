{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["tsconfig.base.json", ".eslintrc.cjs"],
  "globalEnv": [
    "NODE_ENV",
    "APP_NAME",
    "APP_DOMAIN",
    "NEXT_PUBLIC_*",
    "DATABASE_URL",
    "REDIS_URL",
    "CHAIN_ID",
    "RPC_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "env": ["TEST_DATABASE_URL", "TEST_REDIS_URL", "FORK_RPC_URL"]
    }
  }
}
